# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite & Data
*.db
*.db-shm
*.db-wal
data/*.db
data/*.json
!data/.gitkeep

# 用户记忆档案（每个用户一个 md，含隐私，不入库）
data/user-memory/

# Certificates
nginx/certs/

# Build logs
build-*.txt
tsc-out.txt
build.log

# WorkBuddy workspace memory
.workbuddy/

# 临时测试页（orb 动画验证）
app/orb-test/

# 大体积天气背景视频（超过 GitHub 100MB 单文件限制，需 LFS 或去除）
public/weathervideo/lightrain.mp4
public/weathervideo/snow.mp4

# 临时调试脚本 / 探针截图（不入库）
/tmp/
tmp/
_tmp_*
_l1.json
_l2.json

# 桌面端（Electron）
# desktop/node_modules 由 npm 安装（与前端 pnpm 依赖树隔离，见 desktop/package.json 说明）
desktop/node_modules/
desktop/.verify-pgdata/
desktop-build.log
# electron-builder 产物
/release/

# 打包用的常驻缓存：已解压的 Electron 运行时（scripts/desktop/electron-dist.mjs）
/.cache/
