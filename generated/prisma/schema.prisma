generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AgriKnowledge {
  id        String   @id
  title     String
  content   String
  category  String
  tags      String[]
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category])
}

model DailyReport {
  id                  String   @id @default(cuid())
  date                DateTime @default(now()) // 报告日期
  imageUrl            String? // 截图URL
  imageAnalysis       String? // 截图分析结果
  sensorData          Json? // 传感器数据快照
  environmentAnalysis String? // 环境分析结果
  weatherInfo         Json? // 天气信息快照
  suggestions         String? // 建议
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

model access_logs {
  id         BigInt  @id @default(autoincrement())
  ip         String
  method     String?
  path       String?
  status     Int?
  duration   Int?
  user_id    Int?
  user_agent String?
  created_at BigInt
}

model automation_rules {
  id                String  @id
  name              String
  description       String?
  is_active         Int?    @default(1)
  graph_data        String
  trigger_type      String?
  created_at        String
  updated_at        String
  last_triggered_at String?
  execution_count   Int?    @default(0)
}

model banned_ips {
  id         BigInt  @id @default(autoincrement())
  ip         String  @unique
  reason     String?
  banned_by  String?
  expires_at BigInt?
  created_at BigInt
}

model device_logs {
  id          BigInt  @id @default(autoincrement())
  device_name String
  action      String
  operator    String
  details     String?
  created_at  BigInt
}

model email_verifications {
  id         BigInt @id @default(autoincrement())
  email      String
  code       String
  expires_at BigInt
  used       Int?   @default(0)
  created_at BigInt

  @@index([email], map: "idx_email_verifications_email")
  @@index([expires_at], map: "idx_email_verifications_expires_at")
}

model friend_requests {
  id           BigInt  @id @default(autoincrement())
  requester_id Int
  addressee_id Int
  status       String? @default("pending")
  created_at   BigInt
  updated_at   BigInt

  @@unique([requester_id, addressee_id])
}

model friends {
  id         BigInt @id @default(autoincrement())
  user_id    Int
  friend_id  Int
  created_at BigInt
  is_blocked Int?   @default(0)

  @@unique([user_id, friend_id])
}

model group_members {
  id           BigInt  @id @default(autoincrement())
  group_id     Int
  user_id      Int
  role         String? @default("member")
  is_muted     Int?    @default(0)
  joined_at    BigInt
  last_read_at BigInt? @default(0)

  @@unique([group_id, user_id])
}

model groups {
  id         BigInt  @id @default(autoincrement())
  name       String
  owner_id   Int
  avatar_url String?
  created_at BigInt
}

model login_logs {
  id          BigInt  @id @default(autoincrement())
  user_id     Int
  ip          String
  country     String?
  region      String?
  city        String?
  user_agent  String?
  device_type String?
  created_at  BigInt
}

model login_tickets {
  ticket     String  @id
  jwt        String?
  created_at BigInt
}

model messages {
  id          BigInt  @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  group_id    Int?
  content     String?
  type        String? @default("text")
  file_url    String?
  read_at     BigInt?
  created_at  BigInt

  @@index([group_id], map: "idx_messages_group_id")
  @@index([receiver_id, read_at], map: "idx_messages_receiver_read")
  @@index([sender_id, receiver_id], map: "idx_messages_sender_receiver")
}

model scheduled_tasks {
  id              BigInt  @id @default(autoincrement())
  title           String
  cron_expression String?
  execute_at      BigInt?
  action_type     String
  device_id       Int?
  params          String
  is_active       Int?    @default(1)
  created_at      BigInt
  updated_at      BigInt
}

model sensor_readings {
  id            BigInt  @id @default(autoincrement())
  device_id     String? @default("default")
  temperature   Float?
  humidity      Float?
  light         Float?
  co2           Float?
  soil_moisture Float?
  earth_n       Float?
  earth_p       Float?
  earth_k       Float?
  rainfall      Float?
  created_at    BigInt

  @@index([created_at], map: "idx_sensor_readings_created_at")
}

model system_settings {
  key        String @id
  value      String
  updated_at BigInt
}

model users {
  id                    BigInt  @id @default(autoincrement())
  uid                   String? @unique
  email                 String? @unique
  password_hash         String?
  username              String
  avatar_url            String?
  role                  String? @default("user")
  permissions           String? @default("{}")
  wechat_openid         String? @unique
  wechat_unionid        String?
  wework_userid         String?
  qq_openid             String? @unique
  alipay_user_id        String? @unique
  notification_settings String? @default("{}")
  daily_ai_limit        Int?    @default(10)
  daily_ai_usage        Int?    @default(0)
  last_ai_usage_date    String?
  ai_balance            Int?    @default(0)
  email_verified        Int?    @default(0)
  email_verified_at     BigInt?
  public_key            String?
  created_at            BigInt
  updated_at            BigInt

  @@index([email], map: "idx_users_email")
  @@index([uid], map: "idx_users_uid")
  @@index([wechat_openid], map: "idx_users_wechat_openid")
}
