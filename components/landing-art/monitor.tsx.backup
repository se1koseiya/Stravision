"use client"

import { motion, useScroll, useTransform, useSpring, AnimatePresence } from "framer-motion"
import Image from "next/image"
import { 
  ArrowUpRight, BrainCircuit, FileText, Activity, Calendar, ChevronLeft, ChevronRight,
  Sparkles, Zap, Brain, Camera, BarChart3, MessageSquare, Search, Cpu, 
  Loader2, CheckCircle2, Globe, Sun, Sprout, ArrowRight, Eye, Waves, Radio
} from "lucide-react"
import { useRef, useState, useEffect } from "react"
import { DeviceControlCardMock, DataChartCardMock, DiseaseCardMock, TaskCardMock } from "@/components/landing/chat-cards"

export function Monitor() {
  const ref = useRef(null)
  const [currentIndex, setCurrentIndex] = useState(0)
  const [dragOffset, setDragOffset] = useState(0)
  const carouselRef = useRef<HTMLDivElement>(null)
  const lastWheelTimeRef = useRef(0)
  const [hoveredCapability, setHoveredCapability] = useState<number | null>(null)
  const [activeDemo, setActiveDemo] = useState(0)

  // Auto-rotate demo cards
  useEffect(() => {
    const timer = setInterval(() => {
      setActiveDemo((prev) => (prev + 1) % 4)
    }, 4000)
    return () => clearInterval(timer)
  }, [])

  useEffect(() => {
    const element = carouselRef.current
    if (!element) return

    const handleWheelNative = (e: WheelEvent) => {
      if (Math.abs(e.deltaY) > 8 || Math.abs(e.deltaX) > 8) {
        e.preventDefault()

        const now = Date.now()
        if (now - lastWheelTimeRef.current < 650) {
          return
        }

        if (e.deltaY > 8 || e.deltaX > 8) {
          setCurrentIndex((prev) => (prev + 1) % 4)
        } else {
          setCurrentIndex((prev) => (prev - 1 + 4) % 4)
        }
        lastWheelTimeRef.current = now
      }
    }

    element.addEventListener("wheel", handleWheelNative, { passive: false })
    return () => {
      element.removeEventListener("wheel", handleWheelNative)
    }
  }, [])

  const { scrollYProgress } = useScroll({
    target: ref,
    offset: ["start end", "end start"]
  })

  const yBg = useTransform(scrollYProgress, [0, 1], ["0%", "25%"])
  const yPhone = useTransform(scrollYProgress, [0, 1], ["8%", "-8%"])
  const scale = useTransform(scrollYProgress, [0, 0.5, 1], [0.8, 1, 0.95])
  const opacity = useTransform(scrollYProgress, [0, 0.2, 0.8, 1], [0, 1, 1, 0.3])

  // AI 能力卡片数据 - 复用 capabilities-card 的设计理念
  const capabilities = [
    {
      id: 'device-control',
      icon: Zap,
      title: '智能设备控制',
      description: '一句话控制所有设备',
      bgColor: 'from-blue-500/20 via-blue-400/10 to-cyan-500/20',
      iconColor: 'bg-blue-500',
      glowColor: 'shadow-blue-500/50'
    },
    {
      id: 'environment',
      icon: Activity,
      title: '环境监测分析',
      description: '实时数据智能诊断',
      bgColor: 'from-emerald-500/20 via-green-400/10 to-teal-500/20',
      iconColor: 'bg-emerald-500',
      glowColor: 'shadow-emerald-500/50'
    },
    {
      id: 'spectrum',
      icon: BarChart3,
      title: '光谱数据分析',
      description: '18通道精准检测',
      bgColor: 'from-purple-500/20 via-violet-400/10 to-fuchsia-500/20',
      iconColor: 'bg-purple-500',
      glowColor: 'shadow-purple-500/50'
    },
    {
      id: 'vision',
      icon: Camera,
      title: '视觉巡检',
      description: 'AI病虫害识别',
      bgColor: 'from-orange-500/20 via-amber-400/10 to-yellow-500/20',
      iconColor: 'bg-orange-500',
      glowColor: 'shadow-orange-500/50'
    },
    {
      id: 'schedule',
      icon: Calendar,
      title: '定时任务',
      description: '自动化农事管理',
      bgColor: 'from-blue-500/20 via-indigo-400/10 to-purple-500/20',
      iconColor: 'bg-blue-600',
      glowColor: 'shadow-blue-600/50'
    },
    {
      id: 'report',
      icon: FileText,
      title: '报告生成',
      description: '精美数据可视化',
      bgColor: 'from-pink-500/20 via-rose-400/10 to-red-500/20',
      iconColor: 'bg-pink-500',
      glowColor: 'shadow-pink-500/50'
    },
    {
      id: 'knowledge',
      icon: Search,
      title: '知识搜索',
      description: '农业专家知识库',
      bgColor: 'from-teal-500/20 via-cyan-400/10 to-sky-500/20',
      iconColor: 'bg-teal-500',
      glowColor: 'shadow-teal-500/50'
    },
    {
      id: 'ai-advice',
      icon: Brain,
      title: '智能决策',
      description: '专业种植建议',
      bgColor: 'from-violet-500/20 via-purple-400/10 to-indigo-500/20',
      iconColor: 'bg-violet-500',
      glowColor: 'shadow-violet-500/50'
    }
  ]

  return (
    <section ref={ref} className="relative w-full min-h-screen py-32 bg-gradient-to-b from-white via-slate-50 to-white dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950 flex flex-col items-center justify-center overflow-hidden">

      {/* 超强视觉冲击背景 - 多层次动态效果 */}
      <div className="absolute inset-0 z-0 pointer-events-none">
        {/* 动态网格 */}
        <motion.div 
          className="absolute inset-0 opacity-30"
          style={{
            backgroundImage: `
              linear-gradient(to right, rgba(59, 130, 246, 0.1) 1px, transparent 1px),
              linear-gradient(to bottom, rgba(59, 130, 246, 0.1) 1px, transparent 1px)
            `,
            backgroundSize: '40px 40px',
            y: yBg
          }}
        />
        
        {/* 巨大的发光球体 - 创造深度感 */}
        <motion.div 
          className="absolute top-[-20%] left-[-10%] w-[800px] h-[800px] rounded-full"
          style={{
            background: 'radial-gradient(circle, rgba(59, 130, 246, 0.4) 0%, transparent 70%)',
            filter: 'blur(100px)',
          }}
          animate={{
            scale: [1, 1.2, 1],
            opacity: [0.3, 0.5, 0.3],
          }}
          transition={{
            duration: 8,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        />
        
        <motion.div 
          className="absolute bottom-[-20%] right-[-10%] w-[900px] h-[900px] rounded-full"
          style={{
            background: 'radial-gradient(circle, rgba(16, 185, 129, 0.4) 0%, transparent 70%)',
            filter: 'blur(120px)',
          }}
          animate={{
            scale: [1, 1.3, 1],
            opacity: [0.3, 0.6, 0.3],
          }}
          transition={{
            duration: 10,
            repeat: Infinity,
            ease: "easeInOut",
            delay: 1
          }}
        />

        <motion.div 
          className="absolute top-[30%] right-[20%] w-[600px] h-[600px] rounded-full"
          style={{
            background: 'radial-gradient(circle, rgba(168, 85, 247, 0.3) 0%, transparent 70%)',
            filter: 'blur(90px)',
          }}
          animate={{
            scale: [1, 1.15, 1],
            opacity: [0.2, 0.4, 0.2],
          }}
          transition={{
            duration: 7,
            repeat: Infinity,
            ease: "easeInOut",
            delay: 2
          }}
        />

        {/* 流动的粒子效果 */}
        {[...Array(20)].map((_, i) => (
          <motion.div
            key={i}
            className="absolute w-1 h-1 bg-blue-400/30 rounded-full"
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
            }}
            animate={{
              y: [0, -100, 0],
              opacity: [0, 1, 0],
            }}
            transition={{
              duration: 3 + Math.random() * 2,
              repeat: Infinity,
              delay: Math.random() * 3,
              ease: "easeInOut"
            }}
          />
        ))}
      </div>

      {/* AI 边框效果 - 复用 AIControlBorderEffect 的概念 */}
      <motion.div
        className="absolute inset-0 pointer-events-none z-[5]"
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ duration: 2 }}
      >
        <motion.div
          className="absolute inset-0"
          animate={{
            background: [
              'linear-gradient(90deg, transparent 0%, rgba(59,130,246,0.1) 50%, transparent 100%)',
              'linear-gradient(180deg, transparent 0%, rgba(16,185,129,0.1) 50%, transparent 100%)',
              'linear-gradient(270deg, transparent 0%, rgba(168,85,247,0.1) 50%, transparent 100%)',
              'linear-gradient(0deg, transparent 0%, rgba(59,130,246,0.1) 50%, transparent 100%)',
            ],
          }}
          transition={{
            duration: 8,
            repeat: Infinity,
            ease: "linear"
          }}
        />
      </motion.div>

      {/* 震撼的标题区域 - 复用 capabilities-card 的动画风格 */}
      <motion.div
        style={{ scale, opacity }}
        className="relative z-10 text-center max-w-6xl px-4 mb-20"
      >
        <motion.div
          initial={{ opacity: 0, y: 50 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.8 }}
          className="relative"
        >
          {/* 发光的标题背景 */}
          <motion.div
            className="absolute inset-0 blur-3xl opacity-30"
            animate={{
              background: [
                'radial-gradient(circle, rgba(59,130,246,0.6) 0%, transparent 70%)',
                'radial-gradient(circle, rgba(16,185,129,0.6) 0%, transparent 70%)',
                'radial-gradient(circle, rgba(168,85,247,0.6) 0%, transparent 70%)',
                'radial-gradient(circle, rgba(59,130,246,0.6) 0%, transparent 70%)',
              ],
            }}
            transition={{
              duration: 6,
              repeat: Infinity,
              ease: "easeInOut"
            }}
          />

          <motion.div
            className="relative inline-flex items-center gap-3 mb-6"
            initial={{ scale: 0 }}
            whileInView={{ scale: 1 }}
            viewport={{ once: true }}
            transition={{ 
              type: "spring",
              stiffness: 200,
              damping: 15,
              delay: 0.2
            }}
          >
            <motion.div
              className="p-4 bg-gradient-to-br from-blue-500 to-emerald-500 rounded-3xl shadow-2xl"
              animate={{
                rotate: [0, 360],
                scale: [1, 1.1, 1],
              }}
              transition={{
                rotate: { duration: 20, repeat: Infinity, ease: "linear" },
                scale: { duration: 2, repeat: Infinity, ease: "easeInOut" }
              }}
            >
              <Brain className="w-12 h-12 text-white" strokeWidth={2.5} />
            </motion.div>
            
            <motion.div
              animate={{
                opacity: [0.5, 1, 0.5],
              }}
              transition={{
                duration: 2,
                repeat: Infinity,
                ease: "easeInOut"
              }}
            >
              <Sparkles className="w-8 h-8 text-yellow-400" />
            </motion.div>
          </motion.div>

          <h2 className="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight mb-8 leading-[1.1] font-alimama">
            <motion.span
              className="inline-block text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-purple-600 to-emerald-600"
              animate={{
                backgroundPosition: ['0% 50%', '100% 50%', '0% 50%'],
              }}
              transition={{
                duration: 5,
                repeat: Infinity,
                ease: "linear"
              }}
              style={{
                backgroundSize: '200% 200%',
              }}
            >
              用自然语言
            </motion.span>
            <br />
            <motion.span
              className="inline-block"
              initial={{ opacity: 0, x: -50 }}
              whileInView={{ opacity: 1, x: 0 }}
              viewport={{ once: true }}
              transition={{ delay: 0.4 }}
            >
              对话你的
            </motion.span>{' '}
            <motion.span
              className="inline-block text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-600 to-blue-600"
              initial={{ opacity: 0, scale: 0.5 }}
              whileInView={{ opacity: 1, scale: 1 }}
              viewport={{ once: true }}
              transition={{ 
                type: "spring",
                stiffness: 200,
                delay: 0.6
              }}
            >
              IoT设备矩阵
            </motion.span>
          </h2>

          <motion.p
            className="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-12 font-medium leading-relaxed"
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: 0.8 }}
          >
            无需配置复杂的自动化规则，<span className="text-blue-600 dark:text-blue-400 font-bold">一句话即可调度所有硬件</span>。
            <br />
            AI 实时理解你的意图并执行闭环控制，让物联管理<span className="text-emerald-600 dark:text-emerald-400 font-bold">自然如水</span>。
          </motion.p>

          <motion.button
            className="group relative px-8 py-4 rounded-full bg-gradient-to-r from-blue-600 to-emerald-600 text-white font-bold text-lg shadow-2xl overflow-hidden"
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: 1 }}
            whileHover={{ scale: 1.05 }}
            whileTap={{ scale: 0.95 }}
          >
            <motion.div
              className="absolute inset-0 bg-gradient-to-r from-emerald-600 to-blue-600"
              initial={{ x: '100%' }}
              whileHover={{ x: 0 }}
              transition={{ duration: 0.3 }}
            />
            <span className="relative flex items-center gap-2">
              开始体验
              <ArrowUpRight className="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
            </span>
          </motion.button>
        </motion.div>
      </motion.div>

      {/* 能力展示网格 - 复用 capabilities-card 的卡片设计 */}
      <motion.div
        initial={{ opacity: 0, y: 50 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, delay: 0.3 }}
        className="relative z-10 w-full max-w-7xl px-4 mb-20"
      >
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {capabilities.map((capability, index) => {
            const Icon = capability.icon
            return (
              <motion.div
                key={capability.id}
                initial={{ opacity: 0, scale: 0.8, y: 50 }}
                whileInView={{ opacity: 1, scale: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ 
                  delay: index * 0.1,
                  type: "spring",
                  stiffness: 200,
                  damping: 20
                }}
                whileHover={{ 
                  scale: 1.05,
                  y: -10,
                  transition: { duration: 0.2 }
                }}
                onHoverStart={() => setHoveredCapability(index)}
                onHoverEnd={() => setHoveredCapability(null)}
                className="group relative"
              >
                {/* 卡片主体 */}
                <div className={`relative p-6 rounded-3xl bg-gradient-to-br ${capability.bgColor} backdrop-blur-2xl border border-white/20 dark:border-white/10 overflow-hidden transition-all duration-300 ${hoveredCapability === index ? 'shadow-2xl' : 'shadow-lg'}`}>
                  {/* 玻璃反光效果 */}
                  <div className="absolute inset-0 bg-gradient-to-br from-white/40 via-white/5 to-transparent opacity-60 group-hover:opacity-80 transition-opacity" />
                  
                  {/* 边缘高光 */}
                  <div className="absolute inset-0 rounded-3xl ring-1 ring-inset ring-white/20 group-hover:ring-white/40 transition-all" />

                  {/* 悬停时的发光效果 */}
                  <AnimatePresence>
                    {hoveredCapability === index && (
                      <motion.div
                        className={`absolute inset-0 ${capability.glowColor} blur-xl`}
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 0.5 }}
                        exit={{ opacity: 0 }}
                        transition={{ duration: 0.3 }}
                      />
                    )}
                  </AnimatePresence>

                  {/* 内容 */}
                  <div className="relative z-10">
                    {/* 图标 */}
                    <motion.div
                      className={`inline-flex p-4 ${capability.iconColor} rounded-2xl mb-4 text-white shadow-lg`}
                      animate={hoveredCapability === index ? {
                        rotate: [0, -10, 10, -10, 0],
                        scale: [1, 1.1, 1.1, 1.1, 1],
                      } : {}}
                      transition={{ duration: 0.5 }}
                    >
                      <Icon size={28} strokeWidth={2.5} />
                    </motion.div>

                    {/* 标题 */}
                    <h4 className="font-black font-alimama text-lg mb-2 text-zinc-900 dark:text-white">
                      {capability.title}
                    </h4>

                    {/* 描述 */}
                    <p className="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                      {capability.description}
                    </p>

                    {/* 箭头 */}
                    <motion.div
                      className="mt-4 flex justify-end"
                      animate={hoveredCapability === index ? {
                        x: [0, 5, 0],
                      } : {}}
                      transition={{ duration: 0.5, repeat: hoveredCapability === index ? Infinity : 0 }}
                    >
                      <div className={`p-2 rounded-full ${capability.iconColor.replace('bg-', 'text-')}`}>
                        <ArrowRight size={20} />
                      </div>
                    </motion.div>
                  </div>
                </div>

                {/* 悬停时的粒子效果 */}
                <AnimatePresence>
                  {hoveredCapability === index && (
                    <>
                      {[...Array(6)].map((_, i) => (
                        <motion.div
                          key={i}
                          className={`absolute w-2 h-2 ${capability.iconColor} rounded-full`}
                          initial={{ 
                            x: '50%', 
                            y: '50%',
                            scale: 0,
                            opacity: 1
                          }}
                          animate={{
                            x: `${50 + (Math.cos(i * 60 * Math.PI / 180) * 100)}%`,
                            y: `${50 + (Math.sin(i * 60 * Math.PI / 180) * 100)}%`,
                            scale: [0, 1, 0],
                            opacity: [1, 1, 0]
                          }}
                          exit={{ opacity: 0 }}
                          transition={{
                            duration: 1,
                            ease: "easeOut"
                          }}
                        />
                      ))}
                    </>
                  )}
                </AnimatePresence>
              </motion.div>
            )
          })}
        </div>
      </motion.div>

          {/* ================= 3D RING CAROUSEL CONTAINER ================= */}
          <div ref={carouselRef} className="relative w-full max-w-6xl mx-auto h-[620px] flex items-center justify-center [perspective:1500px] [transform-style:preserve-3d] select-none py-10">
            
            {/* Carousel track */}
            <motion.div 
              className="relative w-full max-w-[320px] sm:max-w-[440px] md:max-w-[580px] h-[540px] flex items-center justify-center [transform-style:preserve-3d]"
              drag="x"
              dragConstraints={{ left: 0, right: 0 }}
              dragElastic={0.4}
              onDrag={(event, info) => {
                setDragOffset(info.offset.x)
              }}
              onDragEnd={(event, info) => {
                const swipeThreshold = 50
                if (info.offset.x < -swipeThreshold) {
                  setCurrentIndex((prev) => (prev + 1) % 4)
                } else if (info.offset.x > swipeThreshold) {
                  setCurrentIndex((prev) => (prev - 1 + 4) % 4)
                }
                setDragOffset(0)
              }}
            >
              {[
                {
                  id: 0,
                  badge: "AI Agent 执行级",
                  title: "AI 智能操作设备",
                  description: "基于最先进的农业大语言模型意图理解，能够直接下发精准控制指令至大棚物联网硬件。AI 自适应翻译为底层 Modbus 指令，一句话开闭水泵、风机与补光灯，让设施管理如丝般顺滑。",
                  theme: "from-blue-500/20 via-indigo-500/10 to-teal-500/20",
                  borderTheme: "border-blue-500/30 dark:border-blue-500/20",
                  icon: BrainCircuit,
                  renderGraphic: () => (
                    <div className="w-full bg-[#0A0A0A] border border-gray-800 rounded-2xl overflow-hidden flex flex-col" style={{height: 220}}>
                      <div className="px-3 py-2 border-b border-gray-800 flex items-center gap-2 shrink-0">
                        <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                        <span className="text-xs font-semibold text-white">莓界 AI 助手</span>
                        <span className="text-[10px] text-green-400 flex items-center gap-1 ml-auto"><span className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />在线</span>
                      </div>
                      <div className="flex-1 px-3 py-2 space-y-2 overflow-hidden flex flex-col justify-end">
                        <div className="flex gap-2 justify-end">
                          <div className="bg-blue-600 text-white text-[11px] rounded-2xl rounded-tr-none px-3 py-1.5 max-w-[80%]">把排风扇都打开，保持通风</div>
                        </div>
                        <div className="flex gap-2">
                          <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                          <div className="bg-card text-gray-200 text-[11px] rounded-2xl rounded-tl-none px-3 py-1.5 max-w-[80%]">
                            收到，正在开启排风扇...
                            <div className="mt-1.5"><DeviceControlCardMock /></div>
                          </div>
                        </div>
                      </div>
                      <div className="px-3 py-2 border-t border-gray-800 shrink-0">
                        <div className="h-7 bg-background rounded-full border border-gray-700 px-3 flex items-center text-muted-foreground text-[11px]">请输入您的问题...</div>
                      </div>
                    </div>
                  )
                },
                {
                  id: 1,
                  badge: "数据融合分析",
                  title: "智能报告生成",
                  description: "深度整合温室的温控、精准灌溉与视觉病原体检测历史。AI 自动按周汇总多模态大棚运行态势，输出权威绿控及营养配方建议报告，帮您从宏观视角把控整个果实产季的健康状况。",
                  theme: "from-violet-500/20 via-purple-500/10 to-pink-500/20",
                  borderTheme: "border-violet-500/30 dark:border-violet-500/20",
                  icon: FileText,
                  renderGraphic: () => (
                    <div className="w-full bg-[#0A0A0A] border border-gray-800 rounded-2xl overflow-hidden flex flex-col" style={{height: 220}}>
                      <div className="px-3 py-2 border-b border-gray-800 flex items-center gap-2 shrink-0">
                        <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                        <span className="text-xs font-semibold text-white">莓界 AI 助手</span>
                        <span className="text-[10px] text-green-400 flex items-center gap-1 ml-auto"><span className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />在线</span>
                      </div>
                      <div className="flex-1 px-3 py-2 space-y-2 overflow-hidden flex flex-col justify-end">
                        <div className="flex gap-2 justify-end">
                          <div className="bg-blue-600 text-white text-[11px] rounded-2xl rounded-tr-none px-3 py-1.5 max-w-[80%]">我想看看最近一周的生长数据</div>
                        </div>
                        <div className="flex gap-2">
                          <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                          <div className="bg-card text-gray-200 text-[11px] rounded-2xl rounded-tl-none px-3 py-1.5 max-w-[80%]">
                            好的，这是近7天的环境数据分析报告。
                            <div className="mt-1.5"><DataChartCardMock /></div>
                          </div>
                        </div>
                      </div>
                      <div className="px-3 py-2 border-t border-gray-800 shrink-0">
                        <div className="h-7 bg-background rounded-full border border-gray-700 px-3 flex items-center text-muted-foreground text-[11px]">请输入您的问题...</div>
                      </div>
                    </div>
                  )
                },
                {
                  id: 2,
                  badge: "VLM 视觉巡检",
                  title: "AI 智能诊断",
                  description: "利用滑台与摄像头云台自动采集叶面及浆果图像。结合自研通用农业 VLM 视觉大模型进行病害与成熟度秒级精准扫描，在炭疽病、蚜虫与白粉病爆发前提供绿色防控策略，防患于未然。",
                  theme: "from-rose-500/20 via-red-500/10 to-orange-500/20",
                  borderTheme: "border-rose-500/30 dark:border-rose-500/20",
                  icon: Activity,
                  renderGraphic: () => (
                    <div className="w-full bg-[#0A0A0A] border border-gray-800 rounded-2xl overflow-hidden flex flex-col" style={{height: 220}}>
                      <div className="px-3 py-2 border-b border-gray-800 flex items-center gap-2 shrink-0">
                        <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                        <span className="text-xs font-semibold text-white">莓界 AI 助手</span>
                        <span className="text-[10px] text-green-400 flex items-center gap-1 ml-auto"><span className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />在线</span>
                      </div>
                      <div className="flex-1 px-3 py-2 space-y-2 overflow-hidden flex flex-col justify-end">
                        <div className="flex gap-2 justify-end">
                          <div className="bg-blue-600 text-white text-[11px] rounded-2xl rounded-tr-none px-3 py-1.5 max-w-[80%]">这片叶子看起来有点不对劲，帮我看看？</div>
                        </div>
                        <div className="flex gap-2">
                          <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                          <div className="bg-card text-gray-200 text-[11px] rounded-2xl rounded-tl-none px-3 py-1.5 max-w-[80%]">
                            正在分析图像... 检测到草莓白粉病早期症状。
                            <div className="mt-1.5"><DiseaseCardMock /></div>
                          </div>
                        </div>
                      </div>
                      <div className="px-3 py-2 border-t border-gray-800 shrink-0">
                        <div className="h-7 bg-background rounded-full border border-gray-700 px-3 flex items-center text-muted-foreground text-[11px]">请输入您的问题...</div>
                      </div>
                    </div>
                  )
                },
                {
                  id: 3,
                  badge: "智能任务流",
                  title: "AI 智能任务生成",
                  description: "根据未来七天天候变化，AI 自主为大棚排产科学、可落地的农事日程与设备工作流。水肥调节、遮阳网开合、夜间补光等均可生成延时或定时执行任务，彻底告别繁复规则配置的时代。",
                  theme: "from-amber-500/20 via-orange-500/10 to-yellow-500/20",
                  borderTheme: "border-amber-500/30 dark:border-amber-500/20",
                  icon: Calendar,
                  renderGraphic: () => (
                    <div className="w-full bg-[#0A0A0A] border border-gray-800 rounded-2xl overflow-hidden flex flex-col" style={{height: 220}}>
                      <div className="px-3 py-2 border-b border-gray-800 flex items-center gap-2 shrink-0">
                        <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                        <span className="text-xs font-semibold text-white">莓界 AI 助手</span>
                        <span className="text-[10px] text-green-400 flex items-center gap-1 ml-auto"><span className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" />在线</span>
                      </div>
                      <div className="flex-1 px-3 py-2 space-y-2 overflow-hidden flex flex-col justify-end">
                        <div className="flex gap-2 justify-end">
                          <div className="bg-blue-600 text-white text-[11px] rounded-2xl rounded-tr-none px-3 py-1.5 max-w-[80%]">帮我开启补光灯，设定时长2小时</div>
                        </div>
                        <div className="flex gap-2">
                          <div className="w-6 h-6 rounded-full bg-primary/20 relative overflow-hidden shrink-0"><Image src="/logo.gif" alt="AI" fill className="object-contain p-0.5" unoptimized /></div>
                          <div className="bg-card text-gray-200 text-[11px] rounded-2xl rounded-tl-none px-3 py-1.5 max-w-[80%]">
                            好的，已为您开启补光灯，将在 16:30 自动关闭。
                            <div className="mt-1.5"><TaskCardMock /></div>
                          </div>
                        </div>
                      </div>
                      <div className="px-3 py-2 border-t border-gray-800 shrink-0">
                        <div className="h-7 bg-background rounded-full border border-gray-700 px-3 flex items-center text-muted-foreground text-[11px]">请输入您的问题...</div>
                      </div>
                    </div>
                  )
                }
              ].map((slide, index) => {
                let shortestDiff = index - currentIndex;
                if (shortestDiff > 2) shortestDiff -= 4;
                if (shortestDiff < -2) shortestDiff += 4;

                // Continuous interpolation progress based on the current user drag offset
                const progress = Math.max(-1.5, Math.min(1.5, dragOffset / 420));
                const virtualIndex = shortestDiff + progress;

                let rotateY = 0;
                let x = 0;
                let z = 0;
                let scale = 1;
                let opacity = 1;
                let zIndex = 10;

                if (virtualIndex === 0) {
                  rotateY = 0;
                  x = 0;
                  z = 0;
                  scale = 1;
                  opacity = 1;
                  zIndex = 10;
                } else if (virtualIndex > 0) {
                  if (virtualIndex <= 1) {
                    const t = virtualIndex; // 0 to 1
                    rotateY = -40 * t;
                    x = 420 * t;
                    z = -280 * t;
                    scale = 1 - 0.15 * t;
                    opacity = 1 - 0.45 * t;
                    zIndex = t > 0.5 ? 5 : 10;
                  } else {
                    const t = virtualIndex - 1; // 0 to 1
                    rotateY = -40 - 140 * t;
                    x = 420 * (1 - t);
                    z = -280 - 270 * t;
                    scale = 0.85 - 0.25 * t;
                    opacity = 0.55 - 0.43 * t;
                    zIndex = 1;
                  }
                } else {
                  if (virtualIndex >= -1) {
                    const t = -virtualIndex; // 0 to 1
                    rotateY = 40 * t;
                    x = -420 * t;
                    z = -280 * t;
                    scale = 1 - 0.15 * t;
                    opacity = 1 - 0.45 * t;
                    zIndex = t > 0.5 ? 5 : 10;
                  } else {
                    const t = -virtualIndex - 1; // 0 to 1
                    rotateY = 40 + 140 * t;
                    x = -420 * (1 - t);
                    z = -280 - 270 * t;
                    scale = 0.85 - 0.25 * t;
                    opacity = 0.55 - 0.43 * t;
                    zIndex = 1;
                  }
                }

                const isActive = Math.abs(virtualIndex) < 0.15;
                const pointerEvents: "auto" | "none" = isActive ? "auto" : "none";
                const IconComponent = slide.icon;

                return (
                  <motion.div
                    key={slide.id}
                    className={`absolute inset-0 rounded-[2.5rem] p-6 sm:p-8 flex flex-col justify-between bg-gradient-to-br ${slide.theme} backdrop-blur-2xl border ${slide.borderTheme} shadow-2xl transition-shadow duration-500 cursor-grab active:cursor-grabbing`}
                    animate={{
                      rotateY: rotateY,
                      x: x,
                      z: z,
                      scale: scale,
                      opacity: opacity,
                      zIndex: zIndex,
                    }}
                    transition={{
                      type: "spring",
                      stiffness: 300,
                      damping: 28,
                    }}
                    style={{
                      transformStyle: "preserve-3d",
                      backfaceVisibility: "hidden",
                      pointerEvents: pointerEvents,
                    }}
                    onClick={() => {
                      if (!isActive) {
                        setCurrentIndex(index);
                      }
                    }}
                  >
                    {/* Glassmorphic Aura Ring */}
                    <div className="absolute inset-[-10px] bg-gradient-to-tr from-white/10 to-white/0 rounded-[3rem] blur-md -z-10 border border-white/20" />

                    {/* Card Top Block */}
                    <div className="space-y-4 text-left">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-3">
                          <div className="w-10 h-10 rounded-2xl bg-white/15 dark:bg-black/20 flex items-center justify-center text-zinc-900 dark:text-white border border-white/20 shadow-md">
                            <IconComponent size={20} strokeWidth={2.2} />
                          </div>
                          <div className="text-left">
                            <span className="text-[10px] font-black font-alimama tracking-widest text-zinc-400 dark:text-zinc-500 uppercase block">{slide.badge}</span>
                            <h3 className="text-xl sm:text-2xl font-black font-alimama tracking-tight text-zinc-800 dark:text-white leading-none mt-1">
                              {slide.title}
                            </h3>
                          </div>
                        </div>
                      </div>
                      
                      <p className="text-xs sm:text-sm text-zinc-500 dark:text-zinc-300 leading-relaxed font-medium">
                        {slide.description}
                      </p>
                    </div>

                    {/* Graphic Preview Center Area */}
                    <div className="my-6 w-full flex-1 flex items-center justify-center [transform:translateZ(30px)]">
                      {slide.renderGraphic()}
                    </div>

                    {/* Footer / Interactive prompt */}
                    <div className="flex items-center justify-between text-[10px] font-bold text-zinc-400/80 border-t border-zinc-200/20 dark:border-white/5 pt-4">
                      <span>STRAVISION COGNITIVE AI</span>
                      <span className="flex items-center gap-1 text-emerald-500">
                        <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping" />
                        系统就绪
                      </span>
                    </div>
                  </motion.div>
                );
              })}
            </motion.div>

            {/* Left and Right navigation buttons */}
            <button 
              className="absolute left-0 sm:left-4 z-40 w-12 h-12 rounded-full bg-white/60 dark:bg-zinc-900/60 backdrop-blur-md border border-zinc-200/50 dark:border-zinc-800/50 flex items-center justify-center text-zinc-800 dark:text-white hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-md active:scale-95 cursor-pointer"
              onClick={() => setCurrentIndex((prev) => (prev - 1 + 4) % 4)}
            >
              <ChevronLeft size={24} />
            </button>
            <button 
              className="absolute right-0 sm:right-4 z-40 w-12 h-12 rounded-full bg-white/60 dark:bg-zinc-900/60 backdrop-blur-md border border-zinc-200/50 dark:border-zinc-800/50 flex items-center justify-center text-zinc-800 dark:text-white hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-md active:scale-95 cursor-pointer"
              onClick={() => setCurrentIndex((prev) => (prev + 1) % 4)}
            >
              <ChevronRight size={24} />
            </button>

          </div>

          {/* elegant pagination dots at the bottom */}
          <div className="flex gap-3 mt-6 z-40">
            {[0, 1, 2, 3].map((index) => (
              <button
                key={index}
                className={`h-2 rounded-full transition-all duration-300 cursor-pointer ${
                  index === currentIndex 
                    ? "w-8 bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.5)]" 
                    : "w-2.5 bg-zinc-300 dark:bg-zinc-700 hover:bg-zinc-400 dark:hover:bg-zinc-650"
                }`}
                onClick={() => setCurrentIndex(index)}
              />
            ))}
          </div>
        </div>
      </div>

      {/* Styled JSX for Premium Animations and Grid Mesh Background */}
      <style jsx>{`
        .cyber-grid {
          background-image: radial-gradient(circle, rgba(59, 130, 246, 0.12) 1.2px, transparent 1.2px);
          background-size: 24px 24px;
        }
        @keyframes float {
          0%, 100% {
            transform: translateY(0px);
          }
          50% {
            transform: translateY(-10px);
          }
        }
        @keyframes flow-right {
          to {
            stroke-dashoffset: -40;
          }
        }
        @keyframes flow-left {
          to {
            stroke-dashoffset: 40;
          }
        }
        .flowing-line-blue {
          stroke: url(#blue-grad);
          stroke-dasharray: 8, 12;
          animation: flow-right 2.5s linear infinite;
        }
        .flowing-line-teal {
          stroke: url(#teal-grad);
          stroke-dasharray: 8, 12;
          animation: flow-left 2.5s linear infinite;
        }
        @keyframes soundwave {
          0%, 100% { height: 4px; }
          50% { height: 16px; }
        }
        .wave-bar {
          width: 2.5px;
          background-color: #3b82f6;
          border-radius: 9999px;
        }
        .wave-bar:nth-child(1) { animation: soundwave 1s ease-in-out infinite 0.1s; }
        .wave-bar:nth-child(2) { animation: soundwave 1s ease-in-out infinite 0.3s; }
        .wave-bar:nth-child(3) { animation: soundwave 1s ease-in-out infinite 0.5s; }
        .wave-bar:nth-child(4) { animation: soundwave 1s ease-in-out infinite 0.2s; }
        .wave-bar:nth-child(5) { animation: soundwave 1s ease-in-out infinite 0.4s; }
      `}</style>

    </section>
  )
}